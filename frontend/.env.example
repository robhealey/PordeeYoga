# Copy to frontend/.env.local for local dev. All VITE_ vars are public (shipped to the browser).

# LIFF app ID (from your LINE Login channel's LIFF tab) — enables the in-LINE booking experience.
VITE_LIFF_ID=

# LINE Login channel ID — enables the plain-browser "Log in with LINE" OAuth redirect.
# Leave blank locally to use the dev mock-login fallback instead.
VITE_LINE_LOGIN_CHANNEL_ID=2011601572

# Omise *public* (publishable) test key — safe to expose client-side.
VITE_OMISE_PUBLIC_KEY=pkey_test_...
